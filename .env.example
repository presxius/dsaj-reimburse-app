# Salin menjadi .env lalu isi. File .env tidak ikut di-commit.

# Database PostgreSQL. Gunakan password tanpa karakter @ : / ? # (dipakai di URL koneksi).
POSTGRES_DB=reimburse
POSTGRES_USER=reimburse
POSTGRES_PASSWORD=

# Kunci rahasia sesi Flask. Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set 1 bila aplikasi diakses lewat HTTPS (cookie sesi hanya dikirim via HTTPS).
SESSION_COOKIE_SECURE=0

# Set 1 untuk mengisi akun contoh (password123). Jangan aktifkan di production.
SEED_DEMO=0

# Set 1 untuk memasang PaddleOCR + OpenCV di image backend (build lebih lama, image lebih besar).
WITH_OCR=0
# Ukuran model OCR: tiny | small | medium (makin besar makin akurat, makin butuh RAM).
OCR_MODEL_SIZE=small

# Jumlah worker gunicorn (masing-masing 4 thread) dan port yang dibuka di host.
# Dengan OCR, tiap worker memuat model sendiri (ratusan MB RAM); 1 worker cukup untuk server kecil.
WEB_CONCURRENCY=1
HTTP_PORT=80
